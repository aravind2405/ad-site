# Copy to .env.local for local work. In production these are set in the Vercel project settings
# (Project > Settings > Environment Variables). Never commit real values.

# API key for the email service that delivers contact-form messages (Resend).
RESEND_API_KEY=

# The address that receives the messages. Kept here, never in the source, so it is not published.
CONTACT_TO_EMAIL=

# Optional. Defaults to Resend's shared sender, which can only deliver to the Resend account's own
# address. Set it to an address on a verified domain to send anywhere.
CONTACT_FROM_EMAIL=

# Optional. Raises the GitHub API rate limit for the build (read-only repository facts).
GITHUB_TOKEN=
